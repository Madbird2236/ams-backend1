@@ -0,0 +1,121 @@
+/**
+ * Lead dedupe + first-touch attribution, shared by /api/lead-intake and the
+ * SalesBot e-mail ingestion. Never creates a second lead for the same person.
+ *
+ * Matching (same rules as the DB generated columns):
+ *   email_normalized = lower(trim(email))            (UNIQUE per org)
+ *   phone_normalized = phone without [^0-9+]         (indexed, not unique)
+ * Order: e-mail first, then phone. Existing lead → only EMPTY fields are filled
+ * (name/notes/stage are never overwritten; attribution is first-touch).
+ *
+ * Multi-tenant golden rule: every query is scoped with .eq("org_id", orgId)
+ * because callers use the service-role client.
+ */
+import type { LeadAttribution } from "./attribution";
+import { attributionColumns } from "./attribution";
+
+/** Attribution columns exist only after migration 082 → feature flag. */
+export function attributionEnabled(): boolean {
+  return process.env.CRM_ATTRIBUTION_ENABLED === "1";
+}
+
+export function normalizeEmail(email: string | null | undefined): string | null {
+  const s = (email ?? "").trim().toLowerCase();
+  return s || null;
+}
+
+export function normalizePhone(phone: string | null | undefined): string | null {
+  const s = (phone ?? "").replace(/[^0-9+]/g, "");
+  return s || null;
+}
+
+export interface LeadInput {
+  name: string;
+  email?: string | null;
+  phone?: string | null;
+  company?: string | null;
+  notes?: string | null;
+  source: string;
+  isOps?: boolean;
+  attribution?: LeadAttribution;
+}
+
+export interface UpsertResult {
+  leadId: string;
+  created: boolean;
+}
+
+// Minimal structural type of the Supabase client used here (keeps tests simple).
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+type Db = { from: (table: string) => any };
+
+const ATTR_KEYS = [
+  "segment", "utm_source", "utm_medium", "utm_campaign", "utm_content",
+  "utm_term", "campaign_id", "click_id", "landing_page",
+] as const;
+
+async function findExisting(db: Db, orgId: string, email: string | null, phone: string | null) {
+  if (email) {
+    const { data } = await db.from("crm_leads").select("*")
+      .eq("org_id", orgId).eq("email_normalized", email).maybeSingle();
+    if (data) return data as Record<string, unknown>;
+  }
+  if (phone) {
+    const { data } = await db.from("crm_leads").select("*")
+      .eq("org_id", orgId).eq("phone_normalized", phone)
+      .order("created_at", { ascending: true }).limit(1).maybeSingle();
+    if (data) return data as Record<string, unknown>;
+  }
+  return null;
+}
+
+/** Patch with only the fields that are empty on the existing lead. */
+export function fillEmptyPatch(existing: Record<string, unknown>, input: LeadInput, withAttribution: boolean) {
+  const patch: Record<string, unknown> = {};
+  if (!existing.phone && input.phone) patch.phone = input.phone;
+  if (!existing.email && input.email) patch.email = input.email;
+  if (!existing.company && input.company) patch.company = input.company;
+  if (withAttribution && input.attribution) {
+    // First touch: only when the lead has NO campaign data yet.
+    const hasAny = ATTR_KEYS.some((k) => existing[k]);
+    if (!hasAny) Object.assign(patch, attributionColumns(input.attribution));
+  }
+  return patch;
+}
+
+export async function upsertLead(db: Db, orgId: string, input: LeadInput): Promise<UpsertResult> {
+  const withAttribution = attributionEnabled();
+  const email = normalizeEmail(input.email);
+  const phone = normalizePhone(input.phone);
+
+  const existing = await findExisting(db, orgId, email, phone);
+  if (existing) {
+    const patch = fillEmptyPatch(existing, input, withAttribution);
+    if (Object.keys(patch).length) {
+      const { error } = await db.from("crm_leads").update(patch)
+        .eq("org_id", orgId).eq("id", existing.id as string);
+      if (error) console.error("lead upsert: fill-empty update failed:", error.message);
+    }
+    return { leadId: existing.id as string, created: false };
+  }
+
+  const row: Record<string, unknown> = {
+    org_id: orgId,
+    stage: "new",
+    name: input.name,
+    email: input.email ?? null,
+    phone: input.phone ?? null,
+    company: input.company ?? null,
+    notes: input.notes ?? null,
+    source: input.source,
+    ...(input.isOps ? { is_ops: true } : {}),
+    ...(withAttribution && input.attribution ? attributionColumns(input.attribution) : {}),
+  };
+  const { data, error } = await db.from("crm_leads").insert(row).select("id").single();
+  if (!error && data) return { leadId: data.id as string, created: true };
+
+  // Unique race (same e-mail inserted concurrently) → reuse the winner.
+  const raced = await findExisting(db, orgId, email, null);
+  if (raced) return { leadId: raced.id as string, created: false };
+  throw new Error(`lead insert failed: ${error?.message ?? "unknown"}`);
+}
