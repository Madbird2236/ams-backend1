index 0000000..31aafd4
--- /dev/null
+++ b/src/lib/crm/attribution.ts
@@ -0,0 +1,107 @@
+/**
+ * Campaign attribution for CRM leads (first-touch).
+ *
+ * Pure + side-effect-free (unit-tested). Used by:
+ *   - /api/lead-intake  (JSON body from the website / bots)
+ *   - SalesBot e-mail ingestion (FormSubmit website forms with hidden fields)
+ *
+ * Every value is untrusted input: trimmed, length-capped and restricted to a
+ * safe character set. Unknown/invalid values are dropped (never an error), so
+ * attribution can never block a lead from being created.
+ */
+
+export type Segment = "b2c" | "b2b";
+
+export interface LeadAttribution {
+  segment?: Segment;
+  utm_source?: string;
+  utm_medium?: string;
+  utm_campaign?: string;
+  utm_content?: string;
+  utm_term?: string;
+  campaign_id?: string;
+  click_id?: string;
+  landing_page?: string;
+}
+
+const TOKEN_MAX = 120;
+// Latin letters incl. accents/umlauts (U+00C0–U+024F), digits, simple punctuation.
+const SAFE_TOKEN = /^[A-Za-z0-9\u00C0-\u024F ._\-+:/|()]+$/;
+
+function token(v: unknown, max = TOKEN_MAX): string | undefined {
+  if (typeof v !== "string") return undefined;
+  const s = v.trim().slice(0, max);
+  if (!s || !SAFE_TOKEN.test(s)) return undefined;
+  return s;
+}
+
+function segment(v: unknown): Segment | undefined {
+  if (typeof v !== "string") return undefined;
+  const s = v.trim().toLowerCase();
+  return s === "b2c" || s === "b2b" ? s : undefined;
+}
+
+/** Keep only a same-site path (+ query) — never store foreign URLs or fragments. */
+function landingPath(v: unknown): string | undefined {
+  if (typeof v !== "string") return undefined;
+  const raw = v.trim().slice(0, 1000);
+  if (!raw) return undefined;
+  try {
+    const u = new URL(raw, "https://placeholder.invalid");
+    const path = (u.pathname + u.search).slice(0, 500);
+    return path.startsWith("/") ? path : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+/** Build attribution from a flat key/value object (JSON body or parsed form). */
+export function extractAttribution(input: Record<string, unknown> | null | undefined): LeadAttribution {
+  if (!input || typeof input !== "object") return {};
+  const out: LeadAttribution = {};
+  const seg = segment(input.segment);
+  if (seg) out.segment = seg;
+  for (const k of ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"] as const) {
+    const t = token(input[k]);
+    if (t) out[k] = t;
+  }
+  // campaign_id: explicit, else fall back to utm_campaign (our convention: same value).
+  const cid = token(input.campaign_id) ?? out.utm_campaign;
+  if (cid) out.campaign_id = cid;
+  const click = token(input.click_id, 255) ?? token(input.gclid, 255) ?? token(input.fbclid, 255) ?? token(input.li_fat_id, 255);
+  if (click) out.click_id = click;
+  const lp = landingPath(input.landing_page ?? input.page);
+  if (lp) out.landing_page = lp;
+  return out;
+}
+
+const FIELD_KEYS = new Set([
+  "segment", "utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term",
+  "campaign_id", "click_id", "gclid", "fbclid", "li_fat_id", "landing_page",
+]);
+
+/** True for a "label: value" row that carries attribution (hidden form field). */
+export function isAttributionRow(row: string): boolean {
+  const i = row.indexOf(":");
+  if (i <= 0) return false;
+  return FIELD_KEYS.has(row.slice(0, i).trim().toLowerCase());
+}
+
+/** Parse attribution out of "label: value" rows (FormSubmit table rows). */
+export function attributionFromRows(rows: string[]): LeadAttribution {
+  const obj: Record<string, string> = {};
+  for (const row of rows) {
+    const i = row.indexOf(":");
+    if (i <= 0) continue;
+    const key = row.slice(0, i).trim().toLowerCase();
+    if (FIELD_KEYS.has(key)) obj[key] = row.slice(i + 1).trim();
+  }
+  return extractAttribution(obj);
+}
+
+/** Supabase insert payload (snake_case columns) — empty fields omitted. */
+export function attributionColumns(a: LeadAttribution): Record<string, string> {
+  const out: Record<string, string> = {};
+  for (const [k, v] of Object.entries(a)) if (v) out[k] = v;
+  return out;
+}
