+    const r = await upsertLead(db, ORG, {
+      name: "Max Neu", email: "MAX@example.ch", phone: "+41 79 000 00 00", source: "website", notes: "neu",
+      attribution: { campaign_id: "b2c-new", utm_source: "google" },
+    });
+    expect(r).toEqual({ leadId: "L1", created: false });
+    expect(db.rows).toHaveLength(1);
+    expect(db.rows[0]).toMatchObject({ name: "Max Original", stage: "offer", notes: "alt", campaign_id: "b2c-old", phone: "+41 79 000 00 00" });
+    expect(db.rows[0].utm_source).toBeUndefined(); // first-touch kept
+  });
+
+  it("fills attribution on an existing lead that had none (e.g. came by e-mail before)", async () => {
+    const db = fakeDb([{ id: "L1", org_id: ORG, name: "Anna", email: "anna@example.ch", stage: "new" }]);
+    await upsertLead(db, ORG, { name: "Anna", email: "anna@example.ch", source: "website", attribution: { campaign_id: "b2c-2026-01-untermieter" } });
+    expect(db.rows[0].campaign_id).toBe("b2c-2026-01-untermieter");
+  });
+
+  it("matches WhatsApp/phone-only contacts by normalised phone", async () => {
+    const db = fakeDb([{ id: "L7", org_id: ORG, name: "Luca", phone: "+41797935000", stage: "contacted" }]);
+    const r = await upsertLead(db, ORG, { name: "Luca", phone: "+41 79 793 50 00", source: "whatsapp" });
+    expect(r).toEqual({ leadId: "L7", created: false });
