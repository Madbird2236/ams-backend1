@@ -0,0 +1,92 @@
+-- Migration 082: campaign attribution + lead→project link + campaign funnel view.
+--
+-- ADDITIVE ONLY: new nullable columns, one FK (ON DELETE SET NULL), indexes and
+-- a read-only view. No existing column/constraint/policy is changed, no data is
+-- rewritten. Existing RLS on crm_leads/projects keeps covering the new columns.
+-- The view runs with security_invoker so the caller's RLS applies.
+-- Rollback: supabase/rollbacks/082_crm_attribution_down.sql
+--
+-- Bot contract (CLAUDE.md rule 2): projects gains only a NULLABLE column →
+-- ams_bot_writer inserts keep working unchanged.
+
+-- ── 1. First-touch attribution + next step on leads ─────────────────────────
+ALTER TABLE public.crm_leads
+  ADD COLUMN IF NOT EXISTS segment       TEXT CHECK (segment IN ('b2c','b2b')),
+  ADD COLUMN IF NOT EXISTS utm_source    TEXT CHECK (length(utm_source)   <= 120),
+  ADD COLUMN IF NOT EXISTS utm_medium    TEXT CHECK (length(utm_medium)   <= 120),
+  ADD COLUMN IF NOT EXISTS utm_campaign  TEXT CHECK (length(utm_campaign) <= 120),
+  ADD COLUMN IF NOT EXISTS utm_content   TEXT CHECK (length(utm_content)  <= 120),
+  ADD COLUMN IF NOT EXISTS utm_term      TEXT CHECK (length(utm_term)     <= 120),
+  ADD COLUMN IF NOT EXISTS campaign_id   TEXT CHECK (length(campaign_id)  <= 120),
+  ADD COLUMN IF NOT EXISTS click_id      TEXT CHECK (length(click_id)     <= 255),
+  ADD COLUMN IF NOT EXISTS landing_page  TEXT CHECK (length(landing_page) <= 500),
+  ADD COLUMN IF NOT EXISTS next_step     TEXT CHECK (length(next_step)    <= 300),
+  ADD COLUMN IF NOT EXISTS next_step_due DATE;
+
+CREATE INDEX IF NOT EXISTS idx_crm_leads_org_campaign
+  ON public.crm_leads (org_id, campaign_id) WHERE campaign_id IS NOT NULL;
+
+-- ── 2. Opportunity link: a project (with its offers + invoices) knows the lead
+ALTER TABLE public.projects
+  ADD COLUMN IF NOT EXISTS lead_id UUID REFERENCES public.crm_leads(id) ON DELETE SET NULL;
+
+CREATE INDEX IF NOT EXISTS idx_projects_org_lead
+  ON public.projects (org_id, lead_id) WHERE lead_id IS NOT NULL;
+
+-- ── 3. Campaign funnel (lead → project → offer → invoice), per org ──────────
+-- Per-lead pre-aggregation avoids fan-out double counting.
+CREATE OR REPLACE VIEW public.crm_campaign_funnel
+WITH (security_invoker = true) AS
+WITH lead_projects AS (
+  SELECT p.lead_id, p.id AS project_id, p.stage::text AS project_stage
+  FROM public.projects p
+  WHERE p.lead_id IS NOT NULL
+),
+offer_totals AS (
+  SELECT lp.lead_id,
+         count(o.id)                                             AS offers,
+         coalesce(sum(o.total_chf), 0)                           AS offers_chf,
+         count(o.id) FILTER (WHERE o.status::text = 'accepted')  AS offers_accepted,
+         coalesce(sum(o.total_chf) FILTER (WHERE o.status::text = 'accepted'), 0) AS accepted_chf
+  FROM lead_projects lp
+  JOIN public.offers o ON o.project_id = lp.project_id
+  GROUP BY lp.lead_id
+),
+invoice_totals AS (
+  SELECT lp.lead_id,
+         coalesce(sum(i.total_chf) FILTER (WHERE i.cancelled_at IS NULL), 0) AS invoiced_chf,
+         coalesce(sum(i.paid_chf)  FILTER (WHERE i.cancelled_at IS NULL), 0) AS paid_chf
+  FROM lead_projects lp
+  JOIN public.invoices i ON i.project_id = lp.project_id
+  GROUP BY lp.lead_id
+),
+project_counts AS (
+  SELECT lead_id, count(*) AS projects FROM lead_projects GROUP BY lead_id
+)
+SELECT
+  l.org_id,
+  coalesce(l.campaign_id, '(none)')                    AS campaign_id,
+  l.segment,
+  min(l.created_at)                                    AS first_lead_at,
+  count(*)                                             AS leads,
+  count(*) FILTER (WHERE l.stage <> 'new')             AS leads_worked,
+  count(*) FILTER (WHERE l.stage = 'won')              AS leads_won,
+  coalesce(sum(pc.projects), 0)                        AS projects,
+  coalesce(sum(ot.offers), 0)                          AS offers,
+  coalesce(sum(ot.offers_chf), 0)                      AS offers_chf,
+  coalesce(sum(ot.offers_accepted), 0)                 AS offers_accepted,
+  coalesce(sum(ot.accepted_chf), 0)                    AS accepted_chf,
+  coalesce(sum(it.invoiced_chf), 0)                    AS invoiced_chf,
+  coalesce(sum(it.paid_chf), 0)                        AS paid_chf
+FROM public.crm_leads l
+LEFT JOIN project_counts pc ON pc.lead_id = l.id
+LEFT JOIN offer_totals   ot ON ot.lead_id = l.id
+LEFT JOIN invoice_totals it ON it.lead_id = l.id
+WHERE NOT l.is_ops
+GROUP BY l.org_id, coalesce(l.campaign_id, '(none)'), l.segment;
+
+REVOKE ALL ON public.crm_campaign_funnel FROM anon;
+GRANT SELECT ON public.crm_campaign_funnel TO authenticated;
+
+COMMENT ON VIEW public.crm_campaign_funnel IS
+  'Campaign ROI per org: leads → worked → projects → offers → accepted → invoiced/paid. security_invoker: caller RLS applies.';
