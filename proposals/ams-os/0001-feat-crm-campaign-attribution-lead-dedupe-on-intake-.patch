+import { describe, it, expect, beforeEach, afterEach } from "vitest";
+import { upsertLead, normalizeEmail, normalizePhone, fillEmptyPatch } from "./lead-upsert";
+
+/** In-memory fake of the Supabase query builder for crm_leads. */
+function fakeDb(seed: Record<string, unknown>[] = [], opts: { failInsert?: string; raceRow?: Record<string, unknown> } = {}) {
+  const rows = seed.map((r) => ({ ...r }));
+  const calls: { op: string; filters: [string, unknown][]; payload?: unknown }[] = [];
+  const derive = (r: Record<string, unknown>) => ({
+    ...r,
+    email_normalized: normalizeEmail(r.email as string),
+    phone_normalized: normalizePhone(r.phone as string),
+  });
+  function builder(op: string, payload?: unknown) {
+    const filters: [string, unknown][] = [];
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    const b: any = {};
+    const match = () => rows.map(derive).filter((r) => filters.every(([k, v]) => (r as Record<string, unknown>)[k] === v)) as Record<string, unknown>[];
+    b.select = () => b; b.order = () => b; b.limit = () => b;
+    b.eq = (k: string, v: unknown) => { filters.push([k, v]); return b; };
+    b.maybeSingle = async () => { calls.push({ op, filters: [...filters] }); return { data: match()[0] ?? null, error: null }; };
+    b.single = async () => {
+      calls.push({ op, filters: [...filters], payload });
+      if (op === "insert") {
+        if (opts.failInsert) {
+          if (opts.raceRow) rows.push(opts.raceRow);
+          return { data: null, error: { message: opts.failInsert } };
+        }
+        const id = `lead-${rows.length + 1}`;
+        rows.push({ id, ...(payload as object) });
+        return { data: { id }, error: null };
+      }
+      return { data: null, error: null };
+    };
+    b.then = (res: (v: unknown) => void) => {
+      calls.push({ op, filters: [...filters], payload });
+      if (op === "update") {
+        for (const r of rows) if (filters.every(([k, v]) => (derive(r) as Record<string, unknown>)[k] === v)) Object.assign(r, payload);
+      }
+      res({ error: null });
+    };
+    return b;
+  }
+  return {
+    rows, calls,
+    from: (table: string) => {
+      expect(table).toBe("crm_leads");
+      return {
+        select: () => builder("select").select(),
+        insert: (p: unknown) => builder("insert", p),
+        update: (p: unknown) => builder("update", p),
+      };
+    },
+  };
+}
+
+const ORG = "org-ams";
+const OTHER = "org-other";
+
+describe("upsertLead", () => {
