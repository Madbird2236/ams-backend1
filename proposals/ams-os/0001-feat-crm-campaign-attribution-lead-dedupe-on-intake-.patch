+import { describe, it, expect, vi } from "vitest";
+vi.mock("imapflow", () => ({ ImapFlow: class {} }));
+import { parseFormSubmitLead } from "./email-poll";
+
+const body = [
+  "Someone just submitted your form on https://www.ams-malergeschaeft.ch/.",
+  "Here's what they had to say:",
+  "Name", "Value",
+  "Name", "Max Muster",
+  "E-Mail", "max@example.ch",
+  "Objekt", "3.5-Zimmer-Wohnung",
+  "utm_source", "instagram",
+  "utm_campaign", "b2c-2026-01-untermieter",
+  "segment", "b2c",
+  "Projekt", "Wände und Decken streichen",
+  "Submitted at 2026-10-21 10:00",
+].join("\n");
+
+describe("parseFormSubmitLead attribution", () => {
+  it("extracts attribution and keeps it out of the enquiry text", () => {
+    const r = parseFormSubmitLead("submissions@formsubmit.co", "Neue Offerten-Anfrage — Max Muster", body, "info@maler-ams.ch");
+    expect(r).not.toBeNull();
+    expect(r!.email).toBe("max@example.ch");
+    expect(r!.name).toBe("Max Muster");
+    expect(r!.attribution).toEqual({
+      segment: "b2c", utm_source: "instagram",
+      utm_campaign: "b2c-2026-01-untermieter", campaign_id: "b2c-2026-01-untermieter",
+    });
+    expect(r!.enquiry).toContain("Objekt: 3.5-Zimmer-Wohnung");
+    expect(r!.enquiry).not.toContain("utm_");
+  });
+  it("forms without hidden fields still parse exactly as before (empty attribution)", () => {
+    const plain = body.split("\n").filter((l) => !["utm_source","instagram","utm_campaign","b2c-2026-01-untermieter","segment","b2c"].includes(l)).join("\n");
+    const r = parseFormSubmitLead("submissions@formsubmit.co", null, plain, "info@maler-ams.ch");
+    expect(r!.attribution).toEqual({});
+    expect(r!.enquiry).toBe("Name: Max Muster\nE-Mail: max@example.ch\nObjekt: 3.5-Zimmer-Wohnung\nProjekt: Wände und Decken streichen");
+  });
+  it("non-FormSubmit mail is untouched", () => {
+    expect(parseFormSubmitLead("kunde@example.ch", "Anfrage", "Hallo", "info@maler-ams.ch")).toBeNull();
+  });
+});
