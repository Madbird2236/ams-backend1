+  it("recovers from a unique-constraint race by reusing the winner", async () => {
+    const db = fakeDb([], { failInsert: "duplicate key value violates unique constraint", raceRow: { id: "W1", org_id: ORG, name: "Max", email: "max@example.ch" } });
+    const r = await upsertLead(db, ORG, { name: "Max", email: "max@example.ch", source: "website" });
+    expect(r).toEqual({ leadId: "W1", created: false });
+  });
+
+  it("throws on a real insert failure so the caller can answer 500", async () => {
+    const db = fakeDb([], { failInsert: "connection reset" });
+    await expect(upsertLead(db, ORG, { name: "Max", email: "max@example.ch", source: "website" })).rejects.toThrow(/connection reset/);
+  });
+
+  it("does not write attribution columns while the flag is off (pre-migration safety)", async () => {
