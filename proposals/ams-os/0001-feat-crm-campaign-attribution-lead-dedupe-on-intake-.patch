+    }));
+    expect(res.status).toBe(200);
+    expect(state.leads).toHaveLength(1);
+    expect(state.leads[0]).toMatchObject({
+      org_id: "org-ams", source: "website", utm_source: "instagram", campaign_id: "b2c-2026-01-untermieter",
+      segment: "b2c", landing_page: "/maler-offerte-zuerich/?utm_source=instagram",
