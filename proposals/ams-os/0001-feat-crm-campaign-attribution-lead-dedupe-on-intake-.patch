+});
+
+describe("helpers", () => {
+  it("normalises like the DB generated columns", () => {
+    expect(normalizeEmail("  A@B.CH ")).toBe("a@b.ch");
+    expect(normalizePhone("+41 (79) 793-50-90")).toBe("+41797935090");
