+  beforeEach(() => { process.env.CRM_ATTRIBUTION_ENABLED = "1"; });
+  afterEach(() => { process.env.CRM_ATTRIBUTION_ENABLED = prev; });
+
+  it("creates a new lead with attribution", async () => {
