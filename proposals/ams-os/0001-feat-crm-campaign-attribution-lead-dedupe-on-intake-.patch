+import { describe, it, expect, vi, beforeEach } from "vitest";
+
+// ── Fake service-role client (only what the route touches) ──────────────────
+type Row = Record<string, unknown>;
+const state: { leads: Row[]; convs: Row[]; msgs: Row[]; failInsert: boolean; orgs: Row[] } = {
+  leads: [], convs: [], msgs: [], failInsert: false, orgs: [{ id: "org-ams", slug: "ams-swiss" }],
+};
+const norm = (r: Row) => ({
+  ...r,
+  email_normalized: typeof r.email === "string" ? (r.email as string).trim().toLowerCase() || null : null,
+  phone_normalized: typeof r.phone === "string" ? (r.phone as string).replace(/[^0-9+]/g, "") || null : null,
+});
+function q(table: string, op = "select", payload?: unknown) {
+  const f: [string, unknown][] = [];
+  const src = () => (table === "organizations" ? state.orgs : table === "crm_leads" ? state.leads.map(norm) : []);
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  const b: any = {};
+  b.select = () => b; b.order = () => b; b.limit = () => b; b.gte = () => b;
+  b.eq = (k: string, v: unknown) => { f.push([k, v]); return b; };
+  b.maybeSingle = async () => ({ data: src().find((r) => f.every(([k, v]) => (r as Row)[k] === v)) ?? null, error: null });
+  b.single = async () => {
+    if (table === "crm_leads" && op === "insert") {
+      if (state.failInsert) return { data: null, error: { message: "db down" } };
+      const id = `lead-${state.leads.length + 1}`; state.leads.push({ id, ...(payload as Row) }); return { data: { id }, error: null };
+    }
+    if (table === "crm_conversations" && op === "insert") { const id = `c${state.convs.length + 1}`; state.convs.push({ id, ...(payload as Row) }); return { data: { id }, error: null }; }
+    return { data: null, error: null };
+  };
+  b.then = (res: (v: unknown) => void) => {
+    if (table === "crm_messages" && op === "insert") state.msgs.push(payload as Row);
+    if (table === "crm_leads" && op === "update") for (const r of state.leads) if (f.every(([k, v]) => (norm(r) as Row)[k] === v)) Object.assign(r, payload);
+    if (table === "public_rate_limits" && op === "select") return res({ count: 0, error: null });
+    return res({ data: null, error: null });
+  };
+  return b;
+}
